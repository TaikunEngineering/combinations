<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>engineering.taikun</groupId>
	<artifactId>combinations</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<name>Combinations</name>
	<description>
		A utility for generating combinations and permutations of input collections with relational filtering
	</description>
	<url>https://github.com/TaikunEngineering/combinations</url>

	<licenses>
		<license>
			<name>The Apache Software License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/TaikunEngineering/combinations/issues</url>
	</issueManagement>

	<developers>
		<developer>
			<name>Philip Smith</name>
			<email>super_tycoon@taikun.engineering</email>
			<organization>Taikun Engineering</organization>
			<organizationUrl>https://taikun.engineering</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/TaikunEngineering/combinations.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/TaikunEngineering/combinations.git</developerConnection>
		<url>https://github.com/TaikunEngineering/combinations</url>
	</scm>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration>
					<release>17</release>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>6.1.3</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<properties>
		<project.build.sourceEncoding>ASCII</project.build.sourceEncoding>
	</properties>

</project>